# Required only when fetching fresh data from TMDB.
TMDB_API_KEY=

# Any OpenAI-compatible endpoint can be used. Without a key, CineGuide uses
# a deterministic, grounded fallback answer so the demo still runs.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=data
DATABASE_PATH=data/cineguide.db
